---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist.">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="text-5xl font-extrabold text-slate-900">404</h1>
    <p class="mt-4 text-slate-600">The page you were looking for doesn't exist or has moved.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-lime-700 px-6 py-3 font-semibold text-white shadow hover:bg-lime-600"
    >
      Back to home
    </a>
  </div>
</BaseLayout>
