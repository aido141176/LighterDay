---
import BaseLayout from "../layouts/BaseLayout.astro";
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../content/config/config.json';
import DataFlow from "../components/DataFlow.astro";
import CRM from "../components/CRMForm.astro";
import { BorderBeam } from '../components/magicui/border-beam';

import CRMBooking from "../components/CRMBooking.astro";
import client from '../../tina/__generated__/client';
import PageRenderer from "../../tina/pages/PageRenderer.tsx";
const data = await client.queries.page({relativePath: "about.mdx"});
import "../styles/global.css";
---

<BaseLayout>

		<PageRenderer {...data} client:tina />
		<DataFlow/>
		<CRM/>
		<CRMBooking/>
		    <!-- The custom card component -->
    <BorderBeam client:load />


</BaseLayout>
