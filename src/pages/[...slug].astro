---
import BaseLayout from "../layouts/BaseLayout.astro";
import client from '../../tina/__generated__/client';
import PageRenderer from "../../tina/pages/PageRenderer.tsx";

export async function getStaticPaths() {
  const pagesResponse = await client.queries.pageConnection();
  const pages = (pagesResponse.data.pageConnection.edges || [])
    .filter((p) => !!p?.node)
    .map((p) => p!.node!);

  const staticRoutes = ["home", "about"];

  return pages
    .filter((page) => !staticRoutes.includes(page._sys.filename))
    .map((page) => ({
      params: { slug: page._sys.filename },
      props: { filename: page._sys.filename },
    }));
}

const { filename } = Astro.props;
const data = await client.queries.page({ relativePath: `${filename}.mdx` });
const page = data.data.page;
const postsResponse = await client.queries.blogConnection();
const posts = (postsResponse.data.blogConnection.edges || [])
  .map((p) => p?.node)
  .filter(Boolean);
---

<BaseLayout title={page?.seo?.title} description={page?.seo?.description} image={page?.seo?.image}>
	<PageRenderer {...data} posts={posts} client:tina />
</BaseLayout>
