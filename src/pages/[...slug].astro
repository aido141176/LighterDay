---
import { getCollection } from "astro:content";
import client from "../../tina/__generated__/client";
import PageRenderer from "../../tina/pages/PageRenderer";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const page = await getCollection("page");

	return page
		.filter((p) => p.id !== "admin") // 🚨 exclude Tina admin
		.map((p) => ({
			params: { slug: p.id },
			props: {
				getTinaProps: async () => {
					const [pageData, postsData] = await Promise.all([
						client.queries.page({
							relativePath: p.data.tinaInfo.relativePath,
						}),
						client.queries.blogConnection({
							first: 50,
							sort: "pubDate",
						}),
					]);

					const posts =
						postsData.data.blogConnection.edges
							?.map((edge) => edge?.node)
							.filter(Boolean) ?? [];

					return { ...pageData, posts };
				},
			},
		}));
}

const { getTinaProps } = Astro.props;
const data = await getTinaProps();
---

<BaseLayout>
	<PageRenderer {...data} client:tina />
</BaseLayout>