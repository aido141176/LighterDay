---
import "../styles/global.css";
import NewNav from "../components/navigation/NewNav.astro";
import Footer from "../components/ui/Footer.astro";
import { client } from '../../tina/__generated__/client';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title: titleProp, description: descriptionProp, image: imageProp } = Astro.props;

// 1. Fetch Global Config (Nav, Social, Global SEO)
const response = await client.queries.config({ relativePath: 'config.json' });
const siteSettings = response.data.config;
const navItems = siteSettings.nav;
const socialLinks = siteSettings.contactLinks;
const navStyles = siteSettings.navigationSettings;

// 2. Fetch Page Data based on URL (best-effort; blog routes have no page document)
const { slug } = Astro.params;
const path = slug ? `${slug}.mdx` : 'home.mdx';
let pageContent: any = null;
try {
  const pageresponse = await client.queries.page({ relativePath: path });
  pageContent = pageresponse.data.page;
} catch (e) {
  pageContent = null;
}

// 3. SEO Logic: explicit props win, then page frontmatter, then site-wide config
const metaTitle = titleProp || pageContent?.seo?.title || siteSettings.seo?.title || "LighterDay";
const metaDescription = descriptionProp || pageContent?.seo?.description || siteSettings.seo?.description || "Default Description";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://example.com");
const shareImage = imageProp || pageContent?.seo?.image || siteSettings.seo?.image || "/favicon.svg";

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={shareImage} />

    <!-- Twitter -->
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" href="/favicon.ico" />
  </head>

  <body>
   <NewNav
      navData={navItems}
      socialData={socialLinks}
      styles={navStyles}
    />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>