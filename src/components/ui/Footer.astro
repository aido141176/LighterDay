---
import IconLink from "../react/IconLink";

interface Props {
  siteName?: string;
  contactLinks?: any[];
}

const { siteName = "LighterDay", contactLinks = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 text-white bg-gray-900">
  <div class="grid gap-6 px-4 py-10 mx-auto max-w-7xl md:grid-cols-3">
    <div>
      <h3 class="mb-2 text-lg font-bold text-white">{siteName}</h3>
      <p class="text-sm text-gray-400">
        Professional web design & digital services.
      </p>
    </div>

    <div>
      <h4 class="mb-2 font-semibold text-white">Links</h4>
      <ul class="space-y-1 text-gray-400">
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/blog/">Blog</a></li>
      </ul>
    </div>

    <div>
      <h4 class="mb-2 font-semibold text-white">Connect</h4>
      {
        contactLinks.length > 0 ? (
          <ul class="space-y-3 text-gray-400">
            {contactLinks.map((link) => (
              <li>
                <IconLink {...link} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-gray-400">Coming soon.</p>
        )
      }
    </div>
  </div>

  <div class="pb-4 text-sm text-center text-gray-500">
    © {year} {siteName}
  </div>
</footer>
